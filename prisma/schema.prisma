generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ⚠️  Before merging this PR, run the following SQL in Supabase SQL editor:
//     ALTER TYPE "Role" ADD VALUE 'GROWTH';
// prisma migrate dev cannot be used in production; this must be applied manually.
enum Role { 
  ADMIN
  EDITOR
  WRITER
  READER
  GROWTH
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
  REJECTED
  SCHEDULED
}

enum VoteSide {
  FOR
  AGAINST
}

model User {
  id            String    @id @default(cuid())
  name          String?
  slug          String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  password      String?
  role          Role      @default(READER)
  isActive              Boolean   @default(true)
  lastLoginAt           DateTime?
  lastActiveAt          DateTime?
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  adminNotes            String?   @db.Text
  isBanned              Boolean   @default(false)
  bannedAt              DateTime?
  bannedReason          String?   @db.Text
  bannedBy              String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  articles           Article[]
  bookmarks          Bookmark[]
  articleNotes       ArticleNote[]
  notifications      Notification[]
  passwordResetTokens PasswordResetToken[]
  categoryAssignments CategoryEditor[]
  readingProgress    ReadingProgress[]
  debateVotes        DebateVote[]
  comments           Comment[]
  commentUpvotes     CommentUpvote[]
  warnings           UserWarning[]
  notes              AdminNote[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  articles  Article[]
  editors   CategoryEditor[]
  createdAt DateTime  @default(now())

  @@map("categories")
}

model CategoryEditor {
  id         String @id @default(cuid())
  userId     String
  categoryId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@map("category_editors")
}

model Series {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?   @db.Text
  articles    Article[]
  createdAt   DateTime  @default(now())

  @@map("series")
}

model Article {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  content        String        @db.Text
  excerpt        String?       @db.Text
  coverImage     String?
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id])
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  status         ArticleStatus @default(DRAFT)
  publishedAt    DateTime?
  scheduledAt    DateTime?
  isFeatured     Boolean       @default(false)
  isPinned       Boolean       @default(false)
  isDebate       Boolean       @default(false)
  corrected      Boolean       @default(false)
  correctionNote String?       @db.Text
  editorNote     String?       @db.Text
  viewCount      Int           @default(0)
  seriesId       String?
  series         Series?       @relation(fields: [seriesId], references: [id])
  seriesOrder    Int?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  bookmarks       Bookmark[]
  notes           ArticleNote[]
  views           ArticleView[]
  notifications   Notification[]
  readingProgress ReadingProgress[]
  tags            ArticleTag[]
  comments        Comment[]
  forDebates      Debate[]      @relation("ForArticle")
  againstDebates  Debate[]      @relation("AgainstArticle")

  @@map("articles")
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  articles  ArticleTag[]
  createdAt DateTime     @default(now())

  @@map("tags")
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  progress  Float    @default(0)   // 0–100 percent
  scrollY   Int      @default(0)   // pixel offset for restore
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, updatedAt])
  @@map("reading_progress")
}

model ArticleNote {
  id        String   @id @default(cuid())
  articleId String
  authorId  String
  content   String   @db.Text
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@map("article_notes")
}

model ArticleView {
  id          String   @id @default(cuid())
  articleId   String
  viewedAt    DateTime @default(now())
  sessionHash String?
  referrer    String?
  source      String?  // "Direct" | "Search" | "Social" | "Email" | "Other"

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, viewedAt])
  @@index([viewedAt])
  @@index([sessionHash])
  @@map("article_views")
}

model SiteView {
  id          String   @id @default(cuid())
  viewedAt    DateTime @default(now())
  sessionHash String?
  referrer    String?
  pagePath    String?

  @@index([viewedAt])
  @@index([sessionHash])
  @@map("site_views")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  articleId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("bookmarks")
}

model Subscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())

  @@map("subscribers")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())
  read      Boolean  @default(false)

  @@map("contact_messages")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

model TeamMember {
  id       String  @id @default(cuid())
  name     String
  role     String
  bio      String? @db.Text
  image    String?
  email    String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  @@map("team_members")
}

// ── Debate feature ──────────────────────────────────────────────────────────

model Debate {
  id               String       @id @default(cuid())
  title            String
  description      String?
  forArticleId     String
  againstArticleId String
  forArticle       Article      @relation("ForArticle",     fields: [forArticleId],     references: [id])
  againstArticle   Article      @relation("AgainstArticle", fields: [againstArticleId], references: [id])
  isActive         Boolean      @default(true)
  closesAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  votes            DebateVote[]

  @@index([isActive])
  @@map("debates")
}

model DebateVote {
  id          String   @id @default(cuid())
  debateId    String
  debate      Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousId String?
  side        VoteSide
  createdAt   DateTime @default(now())

  // Authenticated deduplication: one vote per user per debate
  // Anonymous deduplication : one vote per anonymousId per debate
  // NULLs are distinct in Postgres unique constraints so these are safe
  @@unique([debateId, userId])
  @@unique([debateId, anonymousId])
  @@index([debateId, side])
  @@map("debate_votes")
}

// ── Comment feature ─────────────────────────────────────────────────────────

model Comment {
  id         String    @id @default(cuid())
  articleId  String
  article    Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String    @db.Text
  isHidden   Boolean   @default(false)
  hiddenBody String?   @db.Text
  flagReason String?
  isReported Boolean   @default(false)
  parentId   String?
  parent     Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: SetNull)
  replies    Comment[] @relation("Replies")
  upvotes    Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  upvotedBy  CommentUpvote[]

  @@index([articleId, createdAt])
  @@index([isReported])
  @@map("comments")
}

model CommentUpvote {
  id        String  @id @default(cuid())
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_upvotes")
}

// ── User moderation ──────────────────────────────────────────────────────────

model UserWarning {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String   @db.Text
  issuedBy  String   // admin name
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("user_warnings")
}

model AdminNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      String   @db.Text
  authorId  String
  authorName String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("admin_notes")
}

// ── Audit log ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  targetId    String
  targetType  String   @default("user")
  performedBy String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([targetId])
  @@index([performedBy])
  @@index([createdAt])
  @@map("audit_logs")
}

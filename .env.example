# ── Database ──────────────────────────────────────────────────────────────────
# Prisma connection string. Use the Supabase "Transaction" pooler URL for
# serverless deployments, and the direct URL for migrations.
DATABASE_URL="postgresql://postgres:[password]@[host]:5432/postgres?pgbouncer=true&connection_limit=1"
# Direct (non-pooler) connection — required by Prisma CLI and the seed/migration
# scripts (db:push, db:seed, db:studio, prisma.config.ts). The deployed site does
# NOT use this; only local DB tooling does.
DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# ── Authentication (NextAuth.js) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"
# The canonical URL of the deployment. Required for OAuth redirects and email links.
NEXTAUTH_URL="https://theconsilium.co.uk"

# ── Site URL ──────────────────────────────────────────────────────────────────
# Public canonical URL used in metadata, OG images, sitemaps, and email links.
NEXT_PUBLIC_SITE_URL="https://theconsilium.co.uk"

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Found at: https://resend.com/api-keys
RESEND_API_KEY="re_..."

# ── Scheduled publishing (cron) ────────────────────────────────────────────────
# Shared secret used to authenticate calls to /api/publish-scheduled.
# Must match the secret configured in your Vercel Cron or external scheduler.
# Generate with: openssl rand -base64 32
CRON_SECRET="your-cron-secret-here"

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated list of email addresses that are granted ADMIN role on first login.
ADMIN_EMAILS="admin@example.com,another@example.com"

# ── Economic data APIs (optional) ─────────────────────────────────────────────
# FRED (Federal Reserve Economic Data): https://fred.stlouisfed.org/docs/api/api_key.html
# Used for the macro half of the homepage ticker. Market quotes need no key.
FRED_API_KEY=""

# Testing is disabled in production. Hosted interactive setup is operator-only;
# see docs/testing/appointments-and-testing-mode.md. Never point test harnesses at it.
# The local launcher pins database/storage,
# captures email, seeds dedicated accounts and attests the workspace on the server.
TESTING_MODE_ENABLED="0"
# Optional independent workspace ORIGIN, without credentials/path/query/fragment.
# This creates a dashboard link only; it does not enable the simulator there.
TESTING_WORKSPACE_URL=""
